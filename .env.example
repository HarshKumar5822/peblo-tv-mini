# ==============================================================================
# PEBLO TV MINI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Project & Server Configuration
PROJECT_NAME="Peblo TV Mini API"
API_V1_STR=""
ENVIRONMENT="development" # development | staging | production

# Database Connection (PostgreSQL for production/Docker, SQLite for local dev fallback)
DATABASE_URL="postgresql://peblo_user:peblo_password@localhost:5432/peblo_tv"

# Storage Provider Strategy ("local" for local disk, "s3" for Cloudflare R2 / AWS S3)
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage"

# Cloudflare R2 / AWS S3 Production Storage Credentials (Required if STORAGE_PROVIDER="s3")
S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET_NAME="peblo-tv-published-catalog"
S3_ACCESS_KEY_ID="your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
S3_REGION="auto"

# Authentication & Role Keys
JWT_SECRET_KEY="super-secret-production-jwt-key-replace-in-env"
JWT_ALGORITHM="HS256"

# Reference Rules Config Path
REFERENCE_PATH="./reference.json"

# ==============================================================================
# PRODUCTION SECRETS MANAGEMENT STRATEGY
# ==============================================================================
# In production, zero raw secrets should ever be committed to git or stored in plain-text `.env` files.
# We manage production secrets using AWS Secrets Manager or HashiCorp Vault integrated with AWS IAM Roles for Service Accounts (IRSA) / Kubernetes External Secrets Operator.
# During application deployment, secrets are injected securely as environment variables directly into the container runtime memory at container startup, or fetched dynamically on demand using IAM role credentials. Cloudflare R2 storage credentials utilize short-lived API tokens rotated automatically every 30 days via secret rotation Lambda functions.
